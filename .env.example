# ---- Public (bundled into the browser; safe to expose) ----
# Leave the two Supabase values empty to run the local prototype (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# test = banner + every record flagged is_test; live = real data collection.
VITE_STUDY_MODE=test
# Optional (COUHES review not required for this course project).
VITE_ETHICS_APPROVAL_REF=
VITE_STUDY_CONTACT=

# ---- Server-only (Vercel function /api/export). NEVER prefix with VITE_ ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPORT_TOKEN=
